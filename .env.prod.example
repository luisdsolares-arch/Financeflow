# Variables usadas por docker-compose.prod.yml
POSTGRES_DB=finance_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres

APP_ENV=production
DATABASE_URL=postgresql+psycopg://postgres:change_me_postgres@postgres:5432/finance_app
AUTO_CREATE_TABLES=false
SECURITY_HEADERS_ENABLED=true
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
ALLOWED_ORIGINS=["http://localhost"]

JWT_SECRET=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENCRYPTION_KEY=replace_with_very_long_random_value

OPEN_BANKING_PROVIDER=plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=
BELVO_SECRET_ID=
BELVO_SECRET_PASSWORD=
BELVO_BASE_URL=https://sandbox.belvo.com
